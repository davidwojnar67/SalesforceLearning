<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Service_New_Bike</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &apos;New&apos;) &amp;&amp; In_Service__c = true</errorConditionFormula>
    <errorDisplayField>In_Service__c</errorDisplayField>
